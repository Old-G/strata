#!/usr/bin/env bash
# strata-upgrade-all — bring every Strata project on this machine up to the plugin
# version this script ships with, in one command.
#
# Claude Code puts a plugin's bin/ on PATH, so this is callable from any session
# ("обнови страту во всех проектах" → /strata:upgrade → this). It does, per repo,
# exactly what the SessionStart auto-sync does on its own the next time a session
# opens there: strata_upgrade_check.sh --apply-safe from this plugin's templates —
# copy only what cannot lose a local line, leave locally edited files alone and
# name them, stamp .strata/version only when nothing is left over.
#
# It never commits, never pushes, never touches settings.json, CLAUDE.md, wiki/ or
# application code, and never wires the Agent-Session trailer (that is asked per
# repo — reference/agent-session-trailer.md). Linked git worktrees are skipped:
# they are other branches' checkouts and get the scripts when they merge.
#
# Discovery: Claude Code's install registry (every project Strata is installed
# for) plus a scan for .strata/version under each --scan dir (default: ~/Desktop,
# ~/Documents, ~/Projects, ~/code, ~/src, ~/dev, depth 6).
#
# Usage: strata-upgrade-all [--dry-run] [--scan <dir>]...
# Exit: 0 all projects clean · 1 some project has files left for /strata:upgrade

set -uo pipefail
PLUGIN="$(cd "$(dirname "$0")/.." && pwd)"
TPL="$PLUGIN/templates/core/scripts"
CHECK="$TPL/strata_upgrade_check.sh"
VERSION="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PLUGIN/.claude-plugin/plugin.json" | head -1)"
[ -f "$CHECK" ] && [ -n "$VERSION" ] || { echo "strata-upgrade-all: plugin templates not found under $PLUGIN" >&2; exit 2; }

# a > b as release versions: numeric parts, and a prerelease (-rc1) sorts BELOW its
# release — `sort -V` gets that backwards (0.9.0-rc1 > 0.9.0 on macOS).
strata_version_gt() {
  python3 -c '
import re, sys
def key(v):
    m = re.match(r"\s*v?(\d+(?:\.\d+)*)(?:-(\S+))?\s*$", v)
    if not m:
        return None
    return (tuple(int(x) for x in m.group(1).split(".")), 0 if m.group(2) else 1, m.group(2) or "")
a, b = key(sys.argv[1]), key(sys.argv[2])
sys.exit(0 if a is not None and b is not None and a > b else 1)
' "$1" "$2" 2>/dev/null
}

dry=0; scans=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    --scan) [ $# -ge 2 ] || { echo "usage: strata-upgrade-all [--dry-run] [--scan <dir>]..." >&2; exit 2; }; scans+=("$2"); shift 2 ;;
    -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "strata-upgrade-all: unknown argument $1" >&2; exit 2 ;;
  esac
done
[ ${#scans[@]} -gt 0 ] || for d in "$HOME/Desktop" "$HOME/Documents" "$HOME/Projects" "$HOME/code" "$HOME/src" "$HOME/dev"; do
  [ -d "$d" ] && scans+=("$d")
done

candidates="$({
  python3 -c '
import json, sys
try:
    plugins = json.load(open(sys.argv[1]))["plugins"]
except Exception:
    sys.exit(0)
for key, entries in plugins.items():
    if key.split("@")[0] == "strata":
        for e in entries:
            if e.get("projectPath"):
                print(e["projectPath"])
' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json" 2>/dev/null
  for d in ${scans[@]+"${scans[@]}"}; do
    find "$d" -maxdepth 6 \( -name node_modules -o -name .git -o -name .worktrees \) -prune \
      -o -type f -path '*/.strata/version' -print 2>/dev/null | sed 's#/\.strata/version$##'
  done
} | awk 'NF && !seen[$0]++' | sort)"

left_any=0
echo "Strata ${VERSION} — upgrading every project on this machine$([ "$dry" -eq 1 ] && echo ' (dry run: nothing is written)')"
while IFS= read -r repo; do
  [ -d "$repo/scripts" ] && [ -f "$repo/.strata/version" ] || continue
  if git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 \
     && [ "$(cd "$repo" && git rev-parse --path-format=absolute --git-dir 2>/dev/null)" != "$(cd "$repo" && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ]; then
    echo "· $repo — linked worktree, skipped (it gets the scripts when its branch merges)"
    continue
  fi
  have="$(tr -d '[:space:]' < "$repo/.strata/version")"
  if strata_version_gt "$have" "$VERSION"; then
    echo "· $repo — at ${have}, newer than this plugin (${VERSION}); skipped, never downgraded"
    continue
  fi
  if [ "$dry" -eq 1 ]; then
    tmp="$(mktemp -d)"; cp -Rp "$repo/scripts" "$tmp/scripts"
    out="$(cd "$tmp" && bash "$CHECK" --apply-safe "$TPL" scripts)"; rc=$?
    rm -rf "$tmp"
  else
    out="$(cd "$repo" && bash "$CHECK" --apply-safe "$TPL" scripts)"; rc=$?
  fi
  synced="$(printf '%s\n' "$out" | grep -c '^SYNCED' || true)"
  left="$(printf '%s\n' "$out" | grep -E '^(CONFLICT|MISSING|STALE) ' | awk '{print $2}' | tr '\n' ' ')"
  ahead="$(printf '%s\n' "$out" | grep -c '^AHEAD' || true)"
  if [ "$rc" -eq 0 ]; then
    [ "$dry" -eq 1 ] || printf '%s\n' "$VERSION" > "$repo/.strata/version"
    kept=""; [ "${ahead:-0}" -gt 0 ] && kept=", ${ahead} kept as local extensions"
    echo "✓ $repo — ${have} → ${VERSION}: ${synced} file(s) synced${kept}"
  else
    left_any=1
    echo "! $repo — ${synced} synced; edited locally, NOT touched: ${left}→ /strata:upgrade there (version stays ${have})"
  fi
done <<< "$candidates"
[ "$dry" -eq 1 ] || echo "Changes are uncommitted in each repo — review and commit them there."
exit "$left_any"
