#!/usr/bin/env bash
# strata-deepen-gate — a Claude Code `UserPromptSubmit` hook. When a message asks to build or change
# something, it adds one line of context asking the model to run /strata:deepen before planning, so
# the plan aims at the result instead of the task. Questions, slash commands, short replies ("yes",
# "go") and messages with no build verb pass untouched.
#
# Why a hook: a skill description and a SessionStart rule were both measured not to fire on a plain
# "add X" (2026-10-22, three fresh sessions: zero Skill calls); this imperative note at prompt time
# made strata:deepen the first tool call in 2/2 (a polite wording: 0/1).
#
# Not a plugin hook — the plugin ships none (ADR #1). ~/.claude/settings.json calls the newest
# installed copy from the plugin cache; install: reference/deepen-gate.md.
#
# Machine messages pass too: a prompt that opens with a harness tag (`<task-notification>` and the
# like) and any prompt matching a skip pattern — one Python regex per line, matched at the start, from
# STRATA_DEEPEN_SKIP_FILE (default ${XDG_CONFIG_HOME:-~/.config}/strata/deepen-skip) and STRATA_DEEPEN_SKIP. That is where
# an app that relays messages between chats names its relay prefix.
#
# Env: STRATA_DEEPEN=0 disables · STRATA_DEEPEN_MIN_CHARS (default 25) · STRATA_DEEPEN_SKIP (one regex)
# · STRATA_DEEPEN_SKIP_FILE. Fails open: any error adds nothing; a bad skip pattern is ignored.

read -r -d '' GATE_PY <<'PY'
import json, os, re, sys

BUILD = re.compile(
    r"\b(add|build|implement|make|create|fix|change|refactor|rework|redesign|improve|ship|write|"
    r"support|migrate|replace|remove|rename)\b"
    r"|(сдела|добав|реализ|запил|почин|исправ|помен|переде|дорабо|улучш|напиш|созда|внедр|настро|"
    r"убер|замен|перене|надо,? чтобы|нужно,? чтобы|хочу,? чтобы)",
    re.I,
)
# Why: a background-task notice or a scheduled wake-up is the harness talking, not a request; the
# deepen pass on it costs a skill load and a 5-8 line restatement of a message nobody wrote.
HARNESS_TAG = re.compile(r"<[a-z]+-[\w-]*>")  # hyphenated, so a pasted <div> or <b> is still a person


def skip_patterns():
    path = os.environ.get("STRATA_DEEPEN_SKIP_FILE") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "strata", "deepen-skip")
    lines = []
    try:
        with open(path, encoding="utf-8-sig", errors="replace") as f:
            lines = [ln.rstrip("\r\n") for ln in f if ln.strip() and not ln.lstrip().startswith("#")]
    except OSError:
        pass  # no file or unreadable: no extra patterns, the gate itself keeps working
    if os.environ.get("STRATA_DEEPEN_SKIP"):
        lines.append(os.environ["STRATA_DEEPEN_SKIP"])
    out = []
    for ln in lines:
        try:
            out.append(re.compile(ln))
        except re.error:
            pass
    return out


def is_machine_message(prompt):
    return bool(HARNESS_TAG.match(prompt)) or any(p.match(prompt) for p in skip_patterns())


NOTE = (
    "Strata deepen gate: the user's message asks to build or change something. Your FIRST action, "
    "before reading code or planning, is the Skill tool with skill \"strata:deepen\" — follow it "
    "and show its Deeper ask in 5-8 lines, then continue with the task. Skip this only when the "
    "message is a one-line fix, a question, or an exact spec the user wants done as written."
)


def main():
    if os.environ.get("STRATA_DEEPEN") == "0":
        return
    data = json.load(sys.stdin)
    prompt = (data.get("prompt") or "").strip()
    min_chars = int(os.environ.get("STRATA_DEEPEN_MIN_CHARS") or 25)
    if len(prompt) < min_chars or prompt.startswith("/") or not BUILD.search(prompt):
        return
    if is_machine_message(prompt):
        return
    # Why the path: the hook runs in every project, also where the plugin is off and the skill is not loaded.
    skill = os.environ.get("STRATA_GATE_SKILL", "")
    note = NOTE + (f" If that skill is not available, follow {skill} by hand." if os.path.isfile(skill) else "")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                             "additionalContext": note}}))


try:
    main()
except Exception:
    pass
PY

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
# Why -I: a hook runs in the project dir, and `-c` puts it on sys.path — a json.py there would run.
STRATA_GATE_SKILL="${here%/bin}/skills/deepen/SKILL.md" python3 -I -c "$GATE_PY" 2>/dev/null || true
exit 0
