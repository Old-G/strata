# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Python (templates/scripts)
__pycache__/
*.pyc
.venv/

# Local dev
*.log

# NOTE: templates/ and reference/ ARE committed — they are the product.

# Strata enforcement-layer state: session stamps + version stamp are ephemeral
# local bookkeeping (ignored); .strata/state/ is the episodic branch-state layer
# (P2) and is tracked on purpose — it must survive a machine change or a /clear.
.strata/*
!.strata/state/

# --- Strata diagram layer (P4) ---
# wiki/diagrams/<name>.architecture.json (canonical) and <name>.html (current render)
# ARE committed. History keeps only the small JSON snapshots; any historic HTML or a
# compare delta (≈2 MB) is regenerated on demand from the JSON — never committed.
wiki/diagrams/history/*.html
# archify visual-check sidecars (screenshots + receipt) — local evidence, regenerated on demand
wiki/diagrams/*.visual-check.*
