        "note": "Humans write docs/; a hook mirrors it into raw/; the AI ingests raw/ into wiki/ and answers from wiki/ first."
      },
      {
        "id": "enforcement",
        "label": "Enforcement layer",
        "focus": [
          "mirror",
          "marker",
          "stopgate",
          "commitgate",
          "session",
          "guard"
        ],
        "note": "One marker rule read by every gate: Stop blocks once per session, pre-commit blocks the commit, SessionStart shows the debt."
      },
      {
        "id": "process",
        "label": "Process layer",
        "focus": [
          "skills",
          "council",
          "state",
          "wiki",
          "provenance"
        ],
        "note": "Skills route plain language to a flow; risky work meets the council; state carries decisions; commits carry their session."
      }
    ]
