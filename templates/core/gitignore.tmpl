# Strata template — rendered by /strata:init and /strata:adopt into the project .gitignore.
# Merge into an existing .gitignore rather than overwriting it.

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*_rsa
*_ed25519
credentials.json
service-account*.json

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / JS ---
node_modules/
.pnpm-store/
npm-debug.log*
yarn-error.log

# --- Build artifacts ---
dist/
build/
*.tsbuildinfo

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/settings.json

# --- NOTE: raw/ IS committed ---
# raw/ is the read-only AI mirror of docs/ (see WIKI.md / PROJECT_PATTERN §1).
# It is version-controlled on purpose so AI agents read a stable snapshot.
# Do NOT add raw/ here. The sync_raw_mirror.sh hook keeps it in step with docs/.

# --- Strata enforcement-layer state ---
# .strata/sessions/ (gate cadence) and .strata/version (upgrade stamp) are
# ephemeral local bookkeeping — ignored. .strata/state/ is the episodic
# branch-state layer and IS committed on purpose (must survive a machine
# change or a /clear). Do NOT collapse this back to a blanket ".strata/" line.
.strata/*
!.strata/state/

# --- Strata diagram layer (P4) ---
# wiki/diagrams/<name>.architecture.json (canonical) and <name>.html (current render)
# ARE committed. History keeps only the small JSON snapshots; any historic HTML or a
# compare delta (≈2 MB) is regenerated on demand from the JSON — never committed.
wiki/diagrams/history/*.html
# archify visual-check sidecars (screenshots + receipt) — local evidence, regenerated on demand
wiki/diagrams/*.visual-check.*
# `archify compare` writes its delta HTML + receipt to the cwd (the repo root) — never commit it
architecture-delta.html
architecture-delta.receipt.json
